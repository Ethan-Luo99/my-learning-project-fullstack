# 环境变量配置示例文件
# 复制此文件为 .env 并根据实际情况修改配置
# 注意：.env 文件包含敏感信息，不应提交到版本控制系统

# JWT 密钥配置
# 用于签名和验证 JWT 令牌
# 生产环境中请替换为强随机字符串
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# WebSocket 配置
# WebSocket 服务器主机地址
# 开发环境使用 localhost:3000
# 生产环境请替换为实际的域名或 IP 地址
WS_HOST=localhost:3000

# Node 环境
# 可选值：development, production, test
NODE_ENV=development
